#!/bin/sh
# Checks each pushed commit as committed (git archive), not the working tree.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  tree=$(mktemp -d) || exit 1
  git archive "$local_sha" | tar -x -C "$tree"
  python3 "$tree/_src/check_locales.py" || status=1
  if python3 -c 'import jinja2' 2>/dev/null; then
    python3 "$tree/_src/build.py" --check || status=1
  else
    echo "pre-push: jinja2 missing, skipped build.py --check (pages vs translations)" >&2
  fi
  rm -rf "$tree"
done
exit $status
